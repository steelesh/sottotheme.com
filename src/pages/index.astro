---
import Brand from "../components/Brand.astro";
import Editor from "../components/Editor.astro";
import Footer from "../components/Footer.astro";
import Masthead from "../components/Masthead.astro";
import { files } from "../data/files.ts";
import { site } from "../data/site.ts";
import Base from "../layouts/Base.astro";
import { current, hush, order, paint, seal } from "../lib/css.ts";
import "../styles/home.css";

const rules = paint + order(site.swatches.length) + hush(site.swatches) + current(files.map(({ id }) => id));
Astro.csp?.insertStyleHash(seal(rules));
const schema = JSON.stringify({ "@context": "https://schema.org", "@type": "WebSite", name: site.name, url: Astro.site });
---

<Base title={site.title} description={site.description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={schema} />
    <style is:inline set:html={rules}></style>
  </Fragment>
  <div class="hero">
    <canvas class="field" aria-hidden="true"></canvas>
    <Masthead />
    <main class="stage">
      <Brand />
      <Editor />
    </main>
    <div class="marks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <Footer />
    <p class="sr-only" role="status" data-status></p>
  </div>
  <script src="../scripts/home.ts"></script>
</Base>
